{
  "name": "@magicy565/medusa-enterprise-product-context",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Vertical Product Context Medusa v2 plugin for agent-safe product context consumption.",
  "peerDependencies": {
    "@medusajs/framework": "^2.21.2",
    "@medusajs/medusa": "^2.21.2"
  },
  "files": [
    ".medusa/server"
  ],
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin",
    "medusa-v2"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "prepublishOnly": "medusa plugin:build",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./*": "./.medusa/server/src/*.js"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "^1.7.28",
    "@types/node": "^24.0.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^6.0.3",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
