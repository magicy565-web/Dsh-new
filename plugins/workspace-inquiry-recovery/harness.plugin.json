{
  "id": "workspace-inquiry-recovery",
  "version": "0.1.0",
  "kind": "plugin",
  "description": "历史询盘捞回：授权导入、证据绑定决策、未发送草稿；暴露只读工具与 HTTP 路由",
  "entry": "./src/index.mjs",
  "requires": ["storage", "tools", "approval"],
  "provides": ["inquiries"],
  "configSchema": {
    "type": "object",
    "properties": {
      "workspaceId": { "type": "string" },
      "staleDays": { "type": "integer" }
    },
    "additionalProperties": false
  },
  "routes": [
    "GET /api/inquiry-recovery/status",
    "GET /api/inquiry-recovery/opportunities",
    "GET /api/inquiry-recovery/selections",
    "GET /api/inquiry-recovery/conflicts",
    "GET /api/inquiry-recovery/leads/:leadId",
    "POST /api/inquiry-recovery/import",
    "POST /api/inquiry-recovery/leads/:leadId/identity",
    "POST /api/inquiry-recovery/leads/:leadId/select",
    "GET /api/inquiry-recovery/approvals",
    "POST /api/inquiry-recovery/approvals",
    "POST /api/inquiry-recovery/approvals/:approvalId/decide"
  ],
  "tools": ["inquiry_recovery_status", "inquiry_recovery_opportunities", "inquiry_recovery_select"],
  "skills": ["skills/inquiries"]
}
