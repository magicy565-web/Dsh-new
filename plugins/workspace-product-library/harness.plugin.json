{
  "id": "workspace-product-library",
  "version": "0.1.0",
  "kind": "plugin",
  "description": "产品资料库：以 Medusa 商品 + 已审核 Product Context 为事实底座的产品空间，含版本化页面、引用校验、评论、审核与 Agent 工具。",
  "entry": "./src/index.mjs",
  "requires": ["storage", "tools", "approval"],
  "provides": ["productLibrary"],
  "configSchema": {
    "type": "object",
    "properties": {
      "workspaceId": { "type": "string", "minLength": 1 },
      "source": {
        "type": "object",
        "properties": {
          "kind": { "const": "medusa-approved-context" },
          "baseURL": { "type": "string" },
          "readTokenFile": { "type": "string" },
          "allowLoopbackHTTP": { "type": "boolean" },
          "timeoutMs": { "type": "integer", "minimum": 50, "maximum": 10000 }
        },
        "required": ["kind", "baseURL", "readTokenFile"],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "routes": [
    "GET /api/product-library/status",
    "GET /api/product-library/products",
    "GET /api/product-library/products/:productId",
    "POST /api/product-library/products/:productId/open",
    "POST /api/product-library/products/:productId/sync",
    "POST /api/product-library/products/:productId/pages",
    "POST /api/product-library/products/:productId/pages/:pageId/save",
    "POST /api/product-library/products/:productId/pages/:pageId/comments",
    "POST /api/product-library/products/:productId/pages/:pageId/approve"
  ],
  "tools": [
    "product_library_status",
    "product_library_list",
    "product_library_read",
    "product_library_open",
    "product_library_sync",
    "product_library_create_page",
    "product_library_save_page",
    "product_library_comment",
    "product_library_approve_page"
  ]
}
