{
  "id": "workspace-access",
  "version": "0.1.0",
  "kind": "plugin",
  "description": "本地登录会话：安装内核 actor 解析器，非公开路由必须带会话 cookie；角色始终来自 workspace 成员表。",
  "entry": "./src/index.mjs",
  "requires": ["storage", "workspace"],
  "provides": ["access"],
  "configSchema": {
    "type": "object",
    "properties": {
      "workspaceId": { "type": "string", "minLength": 1 },
      "ingressPublicKeyFile": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  },
  "routes": [
    "POST /api/access/login",
    "POST /api/access/logout",
    "GET /api/access/session",
    "GET /api/access/sessions",
    "POST /api/access/sessions/:handle/revoke",
    "GET /sessions",
    "GET /login"
  ],
  "tools": []
}
