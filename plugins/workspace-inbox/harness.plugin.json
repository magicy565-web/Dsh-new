{
  "id": "workspace-inbox",
  "version": "0.1.0",
  "kind": "plugin",
  "description": "收件箱：把自主发生的事（计划触发、待批准）汇到一处；只存通知与引用，不复制业务数据。",
  "entry": "./src/index.mjs",
  "requires": ["storage", "workspace"],
  "provides": ["inbox"],
  "configSchema": {
    "type": "object",
    "properties": {
      "workspaceId": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  },
  "routes": [
    "GET /api/inbox/status",
    "GET /api/inbox",
    "POST /api/inbox/read-all",
    "POST /api/inbox/:id/read"
  ],
  "tools": []
}
