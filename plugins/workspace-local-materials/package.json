{
  "name": "@workspace-agent/pi-local-materials",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Selected local materials, file-first owner references and separate memory proposals for original OMP",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "skills",
    "README.md",
    "AGENTS.md"
  ],
  "main": "./src/extension.js",
  "exports": {
    ".": "./src/extension.js",
    "./files": "./src/files.mjs",
