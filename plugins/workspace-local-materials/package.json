    "./business-memory": "./src/business-memory.mjs"
  },
  "pi": {
    "extensions": [
      "./src/extension.js"
    ],
    "skills": [
      "./skills/local-materials"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.10.4"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  }
