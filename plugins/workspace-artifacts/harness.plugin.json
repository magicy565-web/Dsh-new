{
  "id": "workspace-artifacts",
  "version": "0.1.0",
  "kind": "plugin",
  "description": "工作区文件面：上传 UTF-8 文本、列表、元数据与文本预览。二进制只存不挂到模型。",
  "entry": "./src/index.mjs",
  "requires": ["artifacts", "workspace", "audit", "tools"],
  "provides": [],
  "configSchema": {
    "type": "object",
    "properties": {
      "workspaceId": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  },
  "routes": [
    "POST /api/artifacts",
    "GET /api/artifacts",
    "GET /api/artifacts/:id",
    "GET /api/artifacts/:id/content",
    "GET /api/artifacts/:id/download",
    "GET /files"
  ],
  "tools": ["artifact_write"]
}
