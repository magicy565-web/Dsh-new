{
  "id": "workspace-chat",
  "version": "0.1.0",
  "kind": "plugin",
  "description": "会话、运行与事件流：聊天底座。只持有会话/消息/run/事件，不调用模型、不执行工具、不审批。",
  "entry": "./src/index.mjs",
  "requires": ["storage", "workspace", "audit"],
  "provides": ["chat"],
  "configSchema": {
    "type": "object",
    "properties": {
      "workspaceId": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  },
  "routes": [
    "GET /api/chat/status",
    "POST /api/chat/conversations",
    "GET /api/chat/conversations",
    "GET /api/chat/conversations/:id",
    "POST /api/chat/conversations/:id/messages",
    "GET /api/chat/runs/:id",
    "POST /api/chat/runs/:id/cancel",
    "GET /api/chat/runs/:id/events",
    "GET /api/chat/conversations/:id/approvals",
    "POST /api/chat/approvals/:id",
    "GET /chat"
  ],
  "tools": []
}
