{
  "openapi": "3.1.0",
  "info": {
    "title": "Workspace · ChatGPT dot Worker pull gateway",
    "version": "1.0.0",
    "description": "Reviewed, opt-in, public-only task claim, fenced progress and evidence return. Dot must initiate tool calls. There is no public API for programmatically starting a ChatGPT dot."
  },
  "servers": [
    {
      "url": "https://your-reviewed-workspace-domain.example/api/dot-worker/v1"
    }
  ],
  "security": [
    {
      "dotCredential": []
    }
  ],
  "components": {
    "securitySchemes": {
      "dotCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "Private host-approved token stored only by the connected Dot plugin; not a ChatGPT account token."
      }
    }
  },
  "paths": {
    "/identity": {
      "get": {
        "operationId": "workspace_worker_identity",
        "summary": "Read pre-approved Workspace worker identity; no execution",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    },
    "/inbox": {
      "get": {
        "operationId": "workspace_worker_inbox",
        "summary": "List scoped public task references without private context",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    },
    "/tasks/{taskRef}": {
      "get": {
        "operationId": "workspace_worker_read_task",
        "summary": "Read original authorized public task",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "parameters": [
          {
            "name": "taskRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    },
    "/tasks/{taskRef}/claim": {
      "post": {
        "operationId": "workspace_worker_claim_task",
        "summary": "Atomically claim one task under an original fenced lease",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "parameters": [
          {
            "name": "taskRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "requestId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    },
    "/tasks/{taskRef}/status": {
      "get": {
        "operationId": "workspace_worker_status",
        "summary": "Read cancellation and execution authority",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "parameters": [
          {
            "name": "taskRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    },
    "/tasks/{taskRef}/heartbeat": {
      "post": {
        "operationId": "workspace_worker_heartbeat",
        "summary": "Renew the existing original attempt lease",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "parameters": [
          {
            "name": "taskRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "attemptId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "fence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "attemptId",
                  "fence",
                  "requestId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    },
    "/tasks/{taskRef}/upload-file": {
      "post": {
        "operationId": "workspace_worker_upload_file",
        "summary": "Save exact source-backed artifact bytes from native tools",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "parameters": [
          {
            "name": "taskRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "attemptId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "fence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uploadId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "filename": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "base64": {
                    "type": "string",
                    "maxLength": 1398104
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "attemptId",
                  "fence",
                  "uploadId",
                  "filename",
                  "base64",
                  "sha256"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    },
    "/tasks/{taskRef}/submit-result": {
      "post": {
        "operationId": "workspace_worker_submit_result",
        "summary": "Report original Dot research sources and tool receipt references after file upload",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "parameters": [
          {
            "name": "taskRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "attemptId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "fence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 2048
                    }
                  },
                  "toolEvidence": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "tool": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "receiptId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      },
                      "required": [
                        "tool",
                        "receiptId"
                      ]
                    }
                  }
                },
                "required": [
                  "attemptId",
                  "fence",
                  "requestId",
                  "summary",
                  "sources",
                  "toolEvidence"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    },
    "/tasks/{taskRef}/report-blocked": {
      "post": {
        "operationId": "workspace_worker_report_blocked",
        "summary": "Report original attempt blocker; do not reopen another lease",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "parameters": [
          {
            "name": "taskRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "attemptId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "fence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "attemptId",
                  "fence",
                  "requestId",
                  "message"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    },
    "/tasks/{taskRef}/confirm-stop": {
      "post": {
        "operationId": "workspace_worker_confirm_stop",
        "summary": "Confirm that the original attempt has actually stopped",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "parameters": [
          {
            "name": "taskRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "attemptId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "fence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "attemptId",
                  "fence",
                  "requestId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    },
    "/tasks/{taskRef}/events/{eventId}/ack": {
      "post": {
        "operationId": "workspace_worker_ack_event",
        "summary": "Acknowledge a dot event without granting execution authority",
        "tags": [
          "Dot Worker · scoped public tools"
        ],
        "security": [
          {
            "dotCredential": []
          }
        ],
        "parameters": [
          {
            "name": "taskRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified public dot work receipt"
          },
          "201": {
            "description": "Persisted upload"
          },
          "400": {
            "description": "Invalid public request"
          },
          "401": {
            "description": "Worker credential missing or rejected"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Lease, budget, identity or idempotency conflict"
          }
        }
      }
    }
  }
}
