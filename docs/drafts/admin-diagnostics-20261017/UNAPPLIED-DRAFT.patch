+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn, spawnSync } from 'node:child_process';
+import { ADMIN_CODES,inputCode,serviceFailureCode } from '../acceptance/medusa/create-user.mjs';
+const env={PATH:process.env.PATH,HOME:'/tmp'};
+const password='Synthetic-private-input-2026';
+test('input validation distinguishes email, length and confirmation without returning input',()=>{
+  assert.equal(inputCode('operator@example.test',password),null);
+  assert.equal(inputCode('not an email',password),'ADMIN_INPUT_EMAIL_INVALID');
+  assert.equal(inputCode('operator@example.test','short'),'ADMIN_INPUT_PASSWORD_LENGTH');
+  assert.equal(inputCode('operator@example.test','x'.repeat(257)),'ADMIN_INPUT_PASSWORD_LENGTH');
+  assert.equal(inputCode('operator@example.test',password,password+'different'),'ADMIN_INPUT_PASSWORD_MISMATCH');
+});
+test('service diagnostics emit only fixed codes, never raw exceptions/connection strings',()=>{
+  const cases=[['28P01','ADMIN_DB_SERVICE_REFUSED'],['23505','ADMIN_USER_CONFLICT'],['EROFS','ADMIN_RUNTIME_WRITE_REFUSED']];
+  for(const [code,expected]of cases)assert.equal(serviceFailureCode({code,message:password}),expected);
+  assert.equal(serviceFailureCode({message:'ioredis redis://private:secret@redis'}),'ADMIN_CACHE_SERVICE_REFUSED');
+  assert.equal(serviceFailureCode({message:'knex postgres://private:secret@postgres'}),'ADMIN_DB_SERVICE_REFUSED');
+  assert.equal(serviceFailureCode({message:password},password),'ADMIN_SERVICE_INITIALIZATION_FAILED');
+  assert.ok(!ADMIN_CODES.has(password));
+});
+test('manual invocation with non-TTY or credential argv refuses before child/input',()=>{
+  for(const args of [['--confirm-create-admin'],['--email','operator@example.test','--password',password]]){
+    const r=spawnSync(process.execPath,['acceptance/medusa/create-user.mjs',...args],{env,encoding:'utf8'});
+    assert.equal(r.status,2);assert.match(r.stdout,/ADMIN_TTY_REQUIRED|ADMIN_ARGUMENTS_REFUSED/);
+    assert.ok(!(r.stdout+r.stderr).includes(password));
+  }
+});
+for(const mode of ['delayed','split','invalid','oversize','timeout'])test('private asynchronous fd3 '+mode+' never discloses payload',async()=>{
+  const module=new URL('../acceptance/medusa/create-user.mjs',import.meta.url).href;
+  const code=`import {receivePrivateInput} from ${JSON.stringify(module)};receivePrivateInput(3,${mode==='timeout'?30:2000}).then(p=>{if(p.confirmed!==true||!p.email.includes('@')||p.password.length<16)throw Error();console.log('FD_OK')}).catch(e=>{console.log(e.safeCode==='ADMIN_FD_REFUSED'?'ADMIN_FD_REFUSED':'REFUSED');process.exitCode=2});`;
+  const proc=spawn(process.execPath,['--input-type=module','-e',code],{env,stdio:['ignore','pipe','pipe','pipe']});
+  let out='',err='';proc.stdout.on('data',b=>out+=b);proc.stderr.on('data',b=>err+=b);proc.stdio[3].on('error',()=>{});
+  const payload=JSON.stringify({email:'operator@example.test',password,confirmed:true});
+  if(mode!=='timeout'){
+    await new Promise(r=>setTimeout(r,80));
+    if(mode==='split'){proc.stdio[3].write(payload.slice(0,25));await new Promise(r=>setTimeout(r,20));proc.stdio[3].end(payload.slice(25));}
+    else proc.stdio[3].end(mode==='invalid'?'{'+password:mode==='oversize'?'x'.repeat(4097):payload);
+  }
+  const status=await new Promise(r=>proc.once('close',r));
+  assert.equal(status,['delayed','split'].includes(mode)?0:2);
+  assert.equal(out.trim(),status===0?'FD_OK':'ADMIN_FD_REFUSED');
+  assert.ok(!(out+err).includes(password));assert.equal(err,'');
+});
