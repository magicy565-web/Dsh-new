{
  "openapi": "3.1.0",
  "info": {
    "title": "Enterprise Workspace — Personal Muse pull Worker (scoped REST)",
    "version": "1.0.0-dev",
    "description": "Standalone skill authoring contract extracted from the private development branch; NOT deployed and NOT a live endpoint. Requires Muse-specific Bearer from Vault, never Dot credential. Only public-only data; outbound buyer contact prohibited."
  },
  "servers": [
    {
      "url": "https://UNCONFIGURED-HOST.invalid/api/muse-worker/v1",
      "description": "NOT DEPLOYED. Replace only after verified TLS host."
    }
  ],
  "security": [
    {
      "MuseBearer": []
    }
  ],
  "tags": [
    {
      "name": "Muse Personal Worker",
      "description": "11 scoped operations on a single-user pull bridge"
    }
  ],
