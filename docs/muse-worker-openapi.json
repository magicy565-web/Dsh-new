            "maxLength": 128
          },
          "serviceId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "attemptId": {
            "type": [
              "string",
              "null"
            ]
          },
          "fence": {
            "type": "integer",
            "minimum": 0
          },
          "leaseUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cancellationRequested": {
            "type": "boolean"
          },
          "canExecute": {
            "type": "boolean"
          },
          "deliverySubmitted": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "taskRef",
          "orderId",
          "serviceId",
          "status",
          "fence",
          "cancellationRequested",
          "canExecute",
          "deliverySubmitted",
          "updatedAt"
        ]
      },
      "Identity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "muse": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "contract": {
            "const": "workspace.muse.pull.v1"
          },
          "approved": {
            "type": "boolean"
          },
          "connected": {
            "type": "boolean",
            "description": "Always conservative: not a live execution heartbeat"
          },
          "allowedServices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
