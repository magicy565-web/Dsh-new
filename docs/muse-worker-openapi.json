          "muse",
          "contract",
          "approved",
          "connected",
          "allowedServices"
        ]
      },
      "Inbox": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "tasks": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "taskRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "serviceId": {
                  "type": "string"
                },
                "deadlineAt": {
                  "type": "string",
