        ]
      },
      "UploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attemptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "fence": {
            "type": "integer",
            "minimum": 1
          },
          "uploadId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "filename": {
            "type": "string",
            "maxLength": 160,
            "pattern": "\\.(json|md|txt|csv)$"
          },
          "base64": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 1398104
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "attemptId",
          "fence",
          "uploadId",
          "filename",
          "base64",
          "sha256"
        ],
        "description": "Base64 exactly encodes the uploaded bytes; max 1 MiB raw."
      },
      "UploadResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uploadId": {
            "type": "string",
