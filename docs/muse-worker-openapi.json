          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            }
          },
          "toolEvidence": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/ToolReceipt"
            },
            "default": []
          },
          "evidenceNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "attemptId",
          "fence",
          "requestId",
          "summary",
          "sources"
        ],
        "description": "Must include either nonempty real toolEvidence or nonempty honest evidenceNote. Uploaded file must already exist; real public HTTPS sources, no example/placeholder domains."
      },
      "SubmitResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
