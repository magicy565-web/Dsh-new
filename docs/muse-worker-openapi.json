            "properties": {
              "code": {
                "type": "string",
                "pattern": "^MW_"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "TaskSnapshot": {
