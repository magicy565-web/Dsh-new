{
  "name": "workspace-pi-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node launch.mjs",
    "agent": "node launch.mjs --agent",
