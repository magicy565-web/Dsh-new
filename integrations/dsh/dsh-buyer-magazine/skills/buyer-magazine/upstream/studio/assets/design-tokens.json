{
  "schemaVersion": "1.0",
  "name": "porcelain-editorial",
  "purpose": "Editorial design reference; inspect renderer CSS. Not a runtime-loaded theme.",
  "color": {
    "paper": "#f4f1ea",
    "surface": "#fffdf8",
    "ink": "#202820",
    "muted": "#65675e",
    "accent": "#a83f2c",
    "forest": "#263c33",
    "rule": "#c8c5b8",
    "sage": "#dfe5d7"
  },
  "typography": {
    "display": {
      "family": "Fraunces",
      "fallback": "Georgia, serif",
      "weight": 400,
      "opticalSize": 72,
      "sizePx": {
        "min": 48,
        "max": 112
      },
      "lineHeight": 1
    },
    "body": {
      "family": "Manrope",
      "fallback": "Arial, sans-serif",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "sizePx": {
        "min": 16,
        "max": 18
      },
      "lineHeight": 1.6
    },
    "data": {
      "fontVariantNumeric": "tabular-nums",
      "sizePx": {
        "min": 15,
        "max": 18
      }
    },
    "caption": {
      "sizePx": {
        "min": 12,
        "max": 14
      },
      "lineHeight": 1.5
    },
    "cjk": {
      "bodyFallback": "\"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
      "requiresAuthoredLocalization": true
    }
  },
  "layout": {
    "maxWidthPx": 1280,
    "desktopColumns": 12,
    "sectionSpacingPx": [
      80,
      48,
      24
    ],
    "pageGutterPx": {
      "mobile": 20,
      "tablet": 32,
      "desktop": 48
    },
    "controlTargetPx": 44,
    "comparisonLimit": 3
  },
  "readingBudget": {
    "targetMinutes": 5,
    "englishCoreWordTarget": [
      600,
      950
    ],
    "defaultProductCount": 3,
    "maxProductCount": 6,
    "sourceDrawerWordsExcludedFromCore": true,
    "claim": "Editorial target; not measured reading performance"
  },
  "imagery": {
    "roles": [
      "product",
      "editorial"
    ],
    "documentaryFit": "contain",
    "generatedLabel": "AI-generated editorial illustration",
    "fixtureLabel": "DEMONSTRATION · fictional supplier data",
    "noFakeEvidence": true
  },
  "motion": {
    "normalDurationMs": [
      120,
      240
    ],
    "reducedMotion": "disable nonessential motion",
    "noScrollHijack": true
  },
  "surfaces": {
    "web": [
      "sources",
      "shortlist",
      "compare",
      "request-download",
      "reading-progress"
    ],
    "email": [
      "static facts",
      "safe links",
      "disclosures"
    ],
    "print": [
      "static facts",
      "source references",
      "disclosures"
    ]
  }
}

