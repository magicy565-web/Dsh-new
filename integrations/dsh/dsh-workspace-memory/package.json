{
  "name": "dsh-workspace-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native workspace-scoped, human-reviewed business memory for DeepSeek Harness",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "service.js", "search.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dependencies": { "@workspace/domain-business-memory": "0.1.0", "zod": "4.6.7" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"] }
  }
}
