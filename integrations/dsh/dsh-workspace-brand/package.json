{
  "name": "dsh-workspace-brand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional monochrome Workspace identity for the native DeepSeek Harness client",
  "engines": { "node": ">=24", "dsh": "0.2.1-rc.2" },
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
