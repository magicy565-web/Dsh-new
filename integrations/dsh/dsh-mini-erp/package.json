{
  "name": "dsh-mini-erp",
  "version": "0.6.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Small workspace ERP: products, buyers, orders and atomic supply reservations",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "store.js",
    "cordis.patch.yml",
    "README.md",
    "catalog.js",
    "http.js",
    "client.js",
    "INTER-OFL.txt",
    "THIRD-PARTY-NOTICES.txt",
    "quote-store.js",
    "quotes.js",
    "trade-records.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "dsh-workspace-library"
      ]
    }
  },
  "devDependencies": {
    "@radix-ui/themes": "3.3.0",
    "lucide-react": "1.61.0"
  },
  "dependencies": {
    "@workspace-agent/dsh-commerce-contracts": "1.0.0",
    "@workspace-agent/domain-quote": "1.0.0",
    "@workspace-agent/domain-commerce-network": "0.2.0"
  }
}
