{
  "name": "dsh-mini-erp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Small workspace ERP: products, buyers, orders and atomic supply reservations",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "store.js",
    "cordis.patch.yml",
    "README.md",
    "catalog.js",
    "http.js",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "dsh-workspace-library"
      ]
    }
  }
}
