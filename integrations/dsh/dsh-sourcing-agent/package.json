{
  "name": "@local/dsh-sourcing-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Optional sourcing skills and templates for native DSH sessions; no business stage engine",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "skills/**",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-buyer-magazine": "file:../dsh-buyer-magazine"
  }
}
