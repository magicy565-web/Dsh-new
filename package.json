{
  "name": "workspace-agent",
  "version": "0.5.0-rc.2",
  "private": true,
  "type": "module",
  "description": "A single-enterprise agent workspace release candidate with audited execution, guarded access and recovery",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-backend.mjs",
    "test:ui": "npm run build && node --test test/ui.dom.test.mjs",
    "test:browser": "npm run build && node test/ui.browser.mjs",
    "test:experts": "node --test test/cloud-experts.test.mjs test/cloud-experts.http.test.mjs test/expert-content.test.mjs test/cloud-team-staging.test.mjs test/cloud-team-staging.http.test.mjs",
    "test:experts:browser": "npm run build && node test/cloud-expert-experience.browser.mjs",
    "preview:offline": "npm run build && node scripts/export-preview.mjs",
    "test:all": "npm test && npm run test:ui",
    "test:recovery": "node --test test/recovery.test.mjs test/recovery-control.test.mjs test/native-recovery.test.mjs test/store.test.mjs test/store-migration.test.mjs",
    "test:provider-live": "node scripts/acceptance-provider.mjs",
    "test:release": "npm run test:all && python3 scripts/package-release.py --light && python3 scripts/check-release.py release/Workspace-Agent-v0.5.0-rc.2-App.zip",
    "check:launch": "node scripts/check-launch-gates.mjs",
    "test:provider-native-live": "node scripts/acceptance-native-provider.mjs",
    "test:offline-evidence": "node scripts/validate-local.mjs",
    "test:commerce": "node --test test/commerce.http.test.mjs",
    "test:supply": "node --test test/supply-network.http.test.mjs",
    "test:muse:browser": "npm run build && node test/muse-commerce.browser.mjs",
    "test:goal-context": "node --test test/goal-commerce.http.test.mjs",
    "test:goal-context:browser": "npm run build && node test/goal-commerce.browser.mjs",
    "test:control:browser": "npm run build && node test/master-control.browser.mjs",
    "preview:control": "npm run build && node --experimental-test-module-mocks --import ./test/fixtures/goal-commerce-memory-preload.mjs test/preview-master-control.mjs",
    "test:control:cloud": "npm run build && node test/cloud-control.browser.mjs",
    "test:control:activity": "node --test test/cloud-activity.test.mjs",
    "test:control:muse": "npm run build && npm run test:control:activity && node test/muse-control.browser.mjs && node test/muse-receipts.browser.mjs",
    "test:conversation:ui": "npm run build && node --test --test-isolation=none test/conversation-integration.dom.test.mjs test/muse-conversation-ui.dom.test.mjs test/procurement-conversation-ui.dom.test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "playwright": "1.61.1",
    "jsdom": "29.1.1"
  }
}
