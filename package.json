{
  "name": "workspace-agent",
  "version": "0.5.0-rc.2",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness native workspace plugins and reusable business domains",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dsh-info.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "node scripts/check-dsh.mjs",
    "start": "node scripts/dsh-info.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-dsh.mjs",
    "test:ui": "npm run build:web && node --test test/ui.dom.test.mjs",
    "test:browser": "npm run build:web && node test/ui.browser.mjs",
    "test:experts": "node --test test/cloud-experts.test.mjs test/cloud-experts.http.test.mjs test/expert-content.test.mjs test/cloud-team-staging.test.mjs test/cloud-team-staging.http.test.mjs",
    "test:experts:browser": "npm run build:web && node test/cloud-expert-experience.browser.mjs",
    "preview:offline": "npm run build:web && node scripts/export-preview.mjs",
    "test:all": "npm run test:legacy && npm run test:ui && npm run test:conversation:ui && npm run build:mini",
    "test:recovery": "node --test test/recovery.test.mjs test/recovery-control.test.mjs test/native-recovery.test.mjs test/store.test.mjs test/store-migration.test.mjs",
    "test:provider-live": "node scripts/acceptance-provider.mjs",
    "test:release": "npm run test:all && npm run package:pi",
    "check:launch": "node scripts/check-launch-gates.mjs",
    "test:provider-native-live": "node scripts/acceptance-native-provider.mjs",
    "test:offline-evidence": "node scripts/validate-local.mjs",
    "test:commerce": "node --test test/commerce.http.test.mjs",
    "test:supply": "node --test test/supply-network.http.test.mjs",
    "test:muse:browser": "npm run build:web && node test/muse-commerce.browser.mjs",
    "test:goal-context": "node --test test/goal-commerce.http.test.mjs",
    "test:goal-context:browser": "npm run build:web && node test/goal-commerce.browser.mjs",
    "test:control:browser": "npm run build:web && node test/master-control.browser.mjs",
    "preview:control": "npm run build:web && node --experimental-test-module-mocks --import ./test/fixtures/goal-commerce-memory-preload.mjs test/preview-master-control.mjs",
    "test:control:cloud": "npm run build:web && node test/cloud-control.browser.mjs",
    "test:control:activity": "node --test test/cloud-activity.test.mjs",
    "test:control:muse": "npm run build:web && npm run test:control:activity && node test/muse-control.browser.mjs && node test/muse-receipts.browser.mjs",
    "test:conversation:ui": "npm run build:web && node --test --test-isolation=none test/conversation-integration.dom.test.mjs test/muse-conversation-ui.dom.test.mjs test/procurement-conversation-ui.dom.test.mjs",
    "test:conversation:browser": "npm run build:web && node test/conversation-library.browser.mjs",
    "test:references:browser": "npm run build:web && node test/library-reference-scope.browser.mjs",
    "test:assistant:adapter": "node --test test/assistant-runtime-adapter.test.mjs",
    "test:assistant:browser": "npm run build:web && node test/assistant-workspace.browser.mjs",
    "build:mini": "node scripts/build-miniprogram.mjs",
    "test:pi": "node --test test/pi-runtime.test.mjs",
    "package:pi": "python3 scripts/package-pi-source.py",
    "test:pi:browser": "npm run build:web && node test/pi-conversation.browser.mjs",
    "agent:start": "node --env-file-if-exists=.env server/agent-main.mjs",
    "test:agent": "node --test test/agent-service.http.test.mjs test/agent-workspace.integration.test.mjs test/agent-pi-runtime.test.mjs test/agent-pi-service.http.test.mjs test/agent-owner-policy.test.mjs test/agent-research.test.mjs test/agent-unified-host.http.test.mjs test/agent-coordinator-explicit-recovery.test.mjs test/agent-projection-linkage.test.mjs",
    "test:agent:acceptance": "node test/agent-service.acceptance.mjs",
    "test:agent:client": "python3 test/agent-client.test.py",
    "agent:tui": "node scripts/pi-workspace-tui.mjs",
    "agent:dev": "node scripts/workspace-omp.mjs",
    "factory:local": "node --env-file-if-exists=.env scripts/workspace-omp-local.mjs",
    "workspace": "node scripts/workspace-omp.mjs",
    "agent:pi": "node --env-file-if-exists=.env scripts/pi-workspace-agent.mjs",
    "plugins:check": "node scripts/check-plugins.mjs",
    "plugins:pack-check": "node scripts/check-plugins.mjs --pack",
    "build:web": "tsc --noEmit && vite build",
    "build:omp": "node scripts/build-omp.mjs",
    "test:omp": "node --test test/workspace-omp-unified.test.mjs",
    "test:product-library": "node --test packages/domain-product-library/test/*.test.mjs",
    "legacy:workspace": "node --env-file-if-exists=.env scripts/workspace-omp-legacy.mjs",
    "test:medusa-live": "node scripts/medusa-catalog-live-smoke.mjs",
    "test:dsh": "node scripts/test-dsh.mjs",
    "test:legacy": "node scripts/test-backend.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.28",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "29.1.1",
    "miniprogram-api-typings": "5.2.3",
    "playwright": "1.61.1",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0"
  }
}
