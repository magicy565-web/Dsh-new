# Pi durable application service example. No DSH Host/source is required. Review paths and all settings on the target.
# This does not configure or deploy the required TLS/authentication ingress.
[Unit]
Description=Workspace Agent enterprise backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=workspace-agent
Group=workspace-agent
WorkingDirectory=/opt/workspace-agent
EnvironmentFile=/etc/workspace-agent/server.env
ExecStart=/usr/bin/env NODE_ENV=production WORKSPACE_ACCESS_MODE=enterprise /usr/bin/node /opt/workspace-agent/server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/workspace-agent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
