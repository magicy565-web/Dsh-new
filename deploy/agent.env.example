# Unified original Workspace/Pi server. Keep the populated file ONLY in the
# host secret/configuration store, e.g. /etc/workspace-agent/server.env.
# Reuse the existing enterprise and member values; do not create Agent accounts.
NODE_ENV=production
WORKSPACE_RUNTIME=pi
WORKSPACE_ACCESS_MODE=enterprise
WORKSPACE_DATA_DIR=/var/lib/workspace-agent
PORT=8787
WORKSPACE_PUBLIC_ORIGIN=https://workspace.cnsubscribe.xyz
WORKSPACE_ID=REPLACE_WITH_EXISTING_WORKSPACE_ID
WORKSPACE_INGRESS_ISSUER=REPLACE_WITH_EXISTING_ISSUER
WORKSPACE_INGRESS_KEY_ID=REPLACE_WITH_EXISTING_PUBLIC_KEY_ID
WORKSPACE_INGRESS_PUBLIC_KEY_FILE=/etc/workspace-agent/ingress-public.pem
WORKSPACE_MEMBERS_FILE=/etc/workspace-agent/members.json

# Built-in Agent endpoints. Production never falls back to implicit demo.
WS_AGENT_ENABLED=1
WS_AGENT_DEMO=0
# Bind secure token DIGESTS to existing allowlisted subjects and workspace.
# Empty means no Agent credential has been provisioned; public health/install
# remain available. An Agent token cannot grant a role or bypass original budgets.
WS_AGENT_PRINCIPALS=[]
# Example shape ONLY (replace through safe host settings, not chat):
# WS_AGENT_PRINCIPALS=[{"subject":"existing-member","workspaceId":"existing-workspace","tokenSha256":"REPLACE_WITH_64_LOWERCASE_HEX_DIGEST","scopes":["agent:read","agent:submit"]}]
# Optional expiresAt is an exact ISO timestamp. For a reviewed PR44 migration,
# add legacyAccountId to that same member binding; never infer old ownership.

# JSON presets load on restart. No second model/execution configuration.
# WS_AGENT_PRESETS_DIR=/opt/workspace-agent/presets/agent
# Enable proxy trust only when the reviewed same-host ingress is the only path.
WS_AGENT_TRUST_PROXY=1
WS_AGENT_ALLOWED_HOSTS=workspace.cnsubscribe.xyz

# Existing Pi SDK model selection. Fill the approved endpoint/model and secret
# through secure host configuration. Empty credentials keep production blocked.
PI_BASE_URL=
PI_MODEL=
FASTAITOKEN_API_KEY=

# Optional real, read-only research capability. Explicit enable AND authorized
# credential required; this example performs no search and incurs no usage.
WS_AGENT_RESEARCH_ENABLED=0
BRAVE_SEARCH_API_KEY=

# Existing Shopify host configuration. Writes additionally require this switch,
# original connector enable, exact preview approval and separate execution.
WORKSPACE_SHOPIFY_SHOP_DOMAIN=
WORKSPACE_SHOPIFY_ADMIN_TOKEN=
WORKSPACE_SUPPLIER_SHOPIFY_WRITES_ENABLED=0

# Keep existing reviewed WORKSPACE_MUSE_*, WORKSPACE_DOT_*, WeChat ingress,
# original binding and worker catalog settings unchanged in the host's config.
# Do not put signing private keys, user tokens or populated secret files in git,
# a client config, image layers, command arguments, acceptance logs or chat.
