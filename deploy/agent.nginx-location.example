# Merge into the EXISTING reviewed TLS/identity ingress for this Workspace.
# Replace its original Workspace location instead of adding a second backend.
# This transport snippet does not implement employee authentication or the
# required per-request Ed25519 X-Workspace-Assertion signing adapter. Retain
# that original adapter; strip client identity headers before it signs.
# Agent Bearer, original Muse/Dot and original UI routes reach the same app.
location / {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_next_upstream off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    access_log off;
    add_header X-Accel-Buffering no always;
}
