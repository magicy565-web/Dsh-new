[Unit]
Description=Cnsubscribe unified Workspace Pi service with built-in Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=workspace-agent
Group=workspace-agent
WorkingDirectory=/opt/workspace-agent
EnvironmentFile=/etc/workspace-agent/server.env
# This is the ORIGINAL application, including reviewed Muse/Dot entry points.
# Install this as the existing workspace-agent unit; do not run a second writer.
ExecStart=/usr/bin/env NODE_ENV=production WORKSPACE_ACCESS_MODE=enterprise WORKSPACE_RUNTIME=pi WS_AGENT_ENABLED=1 /usr/bin/node /opt/workspace-agent/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
StateDirectory=workspace-agent
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/workspace-agent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
