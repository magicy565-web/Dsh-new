{
  "publicOrigin": "https://workbench.cnsubscribe.xyz",
  "workspaceId": "REPLACE_EXISTING_WORKSPACE_ID",
  "issuer": "REPLACE_EXISTING_INGRESS_ISSUER",
  "keyId": "REPLACE_EXISTING_INGRESS_KEY_ID",
  "privateKeyFile": "/etc/workspace-authenticated-ingress/signing-ed25519.pem",
  "membersFile": "/etc/workspace/members.json",
  "usernameSubjects": [
    {
      "username": "REPLACE_WITH_APPROVED_CADDY_USERNAME",
      "subject": "REPLACE_EXISTING_APPROVED_MEMBER_SUBJECT"
    }
  ],
  "socketPath": "/run/workspace-authenticated-ingress/ingress.sock",
  "socketMode": "0660",
  "upstream": "http://127.0.0.1:8787",
  "maxBodyBytes": 7100000,
  "maxInFlight": 8,
  "bodyTimeoutMs": 60000,
  "upstreamHeadersTimeoutMs": 25000
}
