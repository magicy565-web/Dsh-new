# EXAMPLE ONLY — replace hostname after real DNS/TLS review.
# This is the *dedicated* Muse API hostname, never the enterprise UI hostname.
# Caddy must be the only public ingress to the loopback Node.js server.
muse-worker.YOUR_VERIFIED_DOMAIN {
    encode zstd gzip
    @muse_api path /api/muse-worker/v1/*
    handle @muse_api {
        # Preserve the Authorization header for dedicated Muse Bearer validation.
        reverse_proxy 127.0.0.1:8787
    }
    # No /api/worker-orders, admin UI, sessions, artifacts, /mcp or health
    # should be reachable through the Muse public hostname.
    handle {
        respond "Not found" 404
    }
}
