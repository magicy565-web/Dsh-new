# Local examples only. Enter fresh authorized credentials on the final host's
# secure environment settings; never paste them into chat or committed files.
# User-selected model is gpt-6-sol. No key, paid test or deployment is implied.
PORT=8787
WORKSPACE_ACCESS_MODE=local
WORKSPACE_RUNTIME=pi
FASTAITOKEN_API_KEY=
PI_MODEL=gpt-6-sol

# Enterprise mode requires an actually reviewed TLS/authentication ingress.
# Filling these fields does not build an IdP or a signing gateway.
# NODE_ENV=production
# WORKSPACE_ACCESS_MODE=enterprise
# WORKSPACE_DATA_DIR=/var/lib/workspace-agent
# WORKSPACE_PUBLIC_ORIGIN=https://workspace.example.invalid
# WORKSPACE_ID=your-workspace
# WORKSPACE_INGRESS_ISSUER=your-reviewed-ingress
# WORKSPACE_INGRESS_KEY_ID=your-key-id
# WORKSPACE_INGRESS_PUBLIC_KEY_FILE=/etc/workspace-agent/ingress-public.pem
# WORKSPACE_MEMBERS_FILE=/etc/workspace-agent/members.json

# Pi-agent-core/pi-durable/pi-ai/chord are pinned to official 1.1.0.
# No DSH source, CLI or Host is required by npm ci/build/start.
# Durable storage is private .data/pi JSONL with fsync:true under Store ownership.
# See docs/PI-RUNTIME.md; model/connector credentials stay on the host.

# ChatGPT dot xy: pull-based PUBLIC-only Worker plugin. Default OFF.
# Do not put the bearer token here, in GitHub, or in the browser.
# Store only its exact SHA-256. The plaintext belongs to the reviewed
# plugin's host-owned credential manager.
# WORKSPACE_DOT_WORKER_ID=chatgpt-dot-xy
# WORKSPACE_DOT_OWNER_ID=xy
# WORKSPACE_DOT_BRIDGE_TOKEN_SHA256=<exact 64-char lower-case digest>
# WORKSPACE_DOT_ENABLED=0
# WORKSPACE_DOT_SCOPE_REVIEWED=0
# WORKSPACE_DOT_EXTERNAL_BUDGET_VERIFIED=0
# The three flags MUST stay off until partner identity, public scope,
# TLS and provider-side enforceable budget are independently verified.
# ChatGPT plugin MCP endpoint is https://<reviewed-persistent-host>/mcp
# The legacy /api/dot-worker/v1 is REST, NOT a ChatGPT MCP plugin endpoint.
# IMPORTANT: the existing pre-shared bearer method is for trusted local
# tests and REST clients. ChatGPT custom MCP connections require OAuth 2.1
# with a reviewed IdP, protected resource metadata, user approval, PKCE and
# token issuer/audience/scope validation. This repository does NOT yet
# provide that OAuth deployment integration; do not mark the xy dot live.
# Host-only read-only probe (never commit token):
# WORKSPACE_DOT_MCP_URL=https://<reviewed-persistent-host>/mcp
# WORKSPACE_DOT_MCP_BEARER=<private token in a secret manager>
# node scripts/check-dot-mcp-connection.mjs
# Product docs: docs/DOT-MCP-CONNECTION.md and docs/DOT-XY-INTEGRATION.md

# Third-party AI Worker (A2A v1) — disabled until a production host has
# independently verified partner identity, Agent Card integrity, network
# egress and a PROVIDER-SIDE ENFORCEABLE HARD SPENDING CAP.
# Only private regular 0600 files on an authorized POSIX host. See docs.
# WORKSPACE_A2A_REGISTRY_FILE=/etc/workspace-agent/worker-registry.json
# WORKSPACE_A2A_REGISTRY_SHA256=<lowercase 64-character SHA256 of private registry>
# WORKSPACE_WORKER_US_RESEARCH_TOKEN=<set only in host secret manager; NEVER in this file>

# Product hosting: read-only Shopify Admin GraphQL integration.
# Configure on the authorized server; the UI never collects or stores the token.
# Use the exact lowercase shop-owned myshopify.com domain, with no URL/path.
# Verification requires a valid Admin token; order evidence needs read_orders.
# History beyond Shopify's normal 60-day window also needs read_all_orders.
# WORKSPACE_SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
# WORKSPACE_SHOPIFY_ADMIN_TOKEN=<host secret manager only; NEVER commit>
# API version is pinned to 2026-10 in server/shopify.mjs.
# This does not enable publishing, advertising, fulfillment writes or billing.
# Product flow and verification: docs/MUSE-COMMERCE-WORKSPACE.md

# Muse Personal Agent Custom Connector: isolated REST API, default OFF.
# Supply ONE dedicated server-to-server Bearer credential to Muse Secure Vault,
# store only its SHA-256 digest on the Workspace host. Never share with Dot.
# Muse may read identity/inbox when configured but cannot claim work until
# all three explicitly audited execution gates are on.
# WORKSPACE_MUSE_WORKER_ID=muse-personal-owner
# WORKSPACE_MUSE_OWNER_ID=personal
# WORKSPACE_MUSE_BRIDGE_TOKEN_SHA256=<exact 64-char lowercase SHA-256 digest>
# WORKSPACE_MUSE_ENABLED=0
# WORKSPACE_MUSE_SCOPE_REVIEWED=0
# WORKSPACE_MUSE_EXTERNAL_BUDGET_VERIFIED=0
# REST base: https://<verified-persistent-host>/api/muse-worker/v1
# Do not enable until dedicated TLS ingress, personal agent scope review and
# provider-side enforceable spending limits have evidence of independent audit.
# See docs/MUSE-PERSONAL-WORKER-REST.md.


# Workspace Supply MCP private pilot (read-only, disabled by default).
# Separate from Muse/Dot. DO NOT put plaintext tokens in the repository.
# WORKSPACE_SOURCING_MCP_ENABLED=0
# WORKSPACE_SOURCING_MCP_TOKEN_SHA256=<SHA-256 of a separate host-stored credential>
# Endpoint: POST /mcp/sourcing. Pilot uses dedicated bearer, not ChatGPT OAuth 2.1.
# Do not publish the endpoint as an installable public connector until OAuth,
# tenant isolation, rate limits and abuse controls pass security review.
# See docs/WORKSPACE-AGENTIC-SUPPLY-V1.md.
