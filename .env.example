# Local examples only. Enter fresh authorized credentials on the final host's
# secure environment settings; never paste them into chat or committed files.
# User-selected model is gpt-6-sol. No key, paid test or deployment is implied.
PORT=8787
WORKSPACE_ACCESS_MODE=local
WORKSPACE_RUNTIME=fastaitoken
FASTAITOKEN_API_KEY=
FASTAITOKEN_MODEL=gpt-6-sol

# Optional direct official DeepSeek text provider, separately approved.
# WORKSPACE_RUNTIME=deepseek-api
# DEEPSEEK_API_KEY=

# Enterprise mode requires an actually reviewed TLS/authentication ingress.
# Filling these fields does not build an IdP or a signing gateway.
# NODE_ENV=production
# WORKSPACE_ACCESS_MODE=enterprise
# WORKSPACE_DATA_DIR=/var/lib/workspace-agent
# WORKSPACE_PUBLIC_ORIGIN=https://workspace.example.invalid
# WORKSPACE_ID=your-workspace
# WORKSPACE_INGRESS_ISSUER=your-reviewed-ingress
# WORKSPACE_INGRESS_KEY_ID=your-key-id
# WORKSPACE_INGRESS_PUBLIC_KEY_FILE=/etc/workspace-agent/ingress-public.pem
# WORKSPACE_MEMBERS_FILE=/etc/workspace-agent/members.json

# Optional real native Harness mode. Read NATIVE-HARNESS.md before enabling tools.
# WORKSPACE_RUNTIME=harness
# DSH_BIN=/absolute/path/to/deepseek-harness/apps/cli/lib/bin.js
# DSH_REVIEWED_PATCH=/absolute/path/to/your-reviewed-profile.patch.yml
# DSH_MODEL=deepseek-v4-flash
# DSH_WORKSPACE_BRIDGE=1
# DSH_WORKSPACE_BRIDGE_PATCH=/absolute/path/to/reviewed-workspace-bridge.patch.yml

# Native FastAIToken route: only use a reviewed explicit registration/profile.
# DSH_PROVIDER=workspace-fastaitoken
# DSH_PROFILE=sdk
# DSH_MODEL=gpt-6-sol
# DSH_PROTOCOL=openai-completions
# DSH_BASE_URL=https://www.fastaitoken.com/v1
# DSH_API_KEY_ENV=FASTAITOKEN_API_KEY
# DSH_RELAY_PATCH=/absolute/path/to/reviewed-fastaitoken-registration.yml
# Protocol/model capacities must be checked against the actual account; see docs.

# Native contained storage for complete offline recovery (review before use).
# DSH_RECOVERY_PATCH=/absolute/path/to/reviewed-native-storage.patch.yml
# Generate it with --storage DATA/harness zstd OUTPUT; see docs/NATIVE-RECOVERY.md
