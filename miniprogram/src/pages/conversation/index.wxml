<view class="conversation">
  <view class="companion"><image class="spirit" src="/assets/spirit.png" mode="aspectFit"/><text class="muted">{{drafting ? '正在整理委托草案' : needsDraftInput ? '等你补充必要信息' : awaitingApproval ? '等待你的决定' : busy ? '正在处理你的目标' : '今天想完成什么？'}}</text></view>
  <scroll-view class="transcript" scroll-y>
    <view wx:if="{{!messages.length}}" class="welcome">说说目标，附上必要的资料。方案、审批、进度和成果都留在这里。</view>
    <view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}"><text selectable>{{item.status === 'pending' ? '正在处理…' : item.content}}</text><text wx:if="{{item.error}}" class="notice">{{item.error.message}}</text></view>
    <view wx:for="{{cards}}" wx:key="id" class="card {{item.kind}}"><text class="card-title">{{item.title}}</text><text class="card-detail">{{item.detail}}</text><button wx:if="{{item.operation || item.file}}" class="card-action secondary" data-id="{{item.id}}" bindtap="card" disabled="{{loading || uncertain}}">{{item.kind === 'file' ? '校验并打开' : item.operation === 'approve' ? '审阅并决定' : item.operation === 'resume' ? '明确继续' : item.operation === 'recover' ? '恢复原任务' : item.operation === 'refresh' ? '核对原进度' : item.operation === 'dispatch' ? '派发原订单' : item.operation === 'accept' ? '核对并验收' : '请求停止'}}</button></view>
    <view wx:for="{{draftCards}}" wx:key="id" class="card draft-card"><text class="card-title">{{item.title}}</text><text class="card-detail">{{item.summary}}</text><text wx:if="{{item.detail}}" class="notice">{{item.detail}}</text><text wx:for="{{item.questions}}" wx:for-item="question" wx:key="*this" class="draft-question">{{question}}</text><text class="muted">{{item.budget}} · 截止 {{item.deadline}}</text><text wx:if="{{item.orderId}}" class="muted">已关联原订单 {{item.orderId}}</text><button wx:if="{{item.editable || item.rejectable}}" class="secondary card-action" data-id="{{item.id}}" bindtap="openDraft" disabled="{{loading || uncertain}}">{{item.phase === 'prepared' ? '核对或拒绝原草案' : item.ready ? '审阅草案' : '查看或编辑草案'}}</button></view>
    <view wx:for="{{supplierCards}}" wx:key="id" class="card supplier-card"><text class="card-title">{{item.title}}</text><text class="muted">{{item.status}} · 修订 {{item.revision}}</text><text class="card-detail">{{item.detail}}</text><text wx:for="{{item.questions}}" wx:for-item="question" wx:key="*this" class="draft-question">{{question}}</text><text wx:if="{{item.extraQuestions}}" class="muted">另有 {{item.extraQuestions}} 项必要信息，可展开内部资料；未知可保留。</text><text wx:for="{{item.suggestions}}" wx:for-item="suggestion" wx:key="*this" class="muted">{{suggestion}}</text><text wx:if="{{item.error}}" class="notice">{{item.error}}</text><text class="muted">{{item.external}}</text><text wx:if="{{item.product}}" class="muted">{{item.product}}</text><supplier-listing-preview wx:if="{{item.preview}}" data-id="{{item.id}}" preview="{{item.preview}}"/><view class="supplier-actions"><button class="secondary" data-id="{{item.id}}" data-kind="edit" bindtap="supplierAction" disabled="{{loading || uncertain || !item.editable}}">补充商品</button><button class="primary" data-id="{{item.id}}" data-kind="preview" bindtap="supplierAction" disabled="{{loading || uncertain || !item.editable}}">审阅预览</button><button class="quiet" data-id="{{item.id}}" bindtap="openSupplierResources" disabled="{{loading || uncertain}}">资源与结果</button></view></view>
    <view wx:if="{{verifiedProductImage &amp;&amp; verifiedProductImage.serviceId === selectedSupplierId}}" class="card"><image class="supplier-image" src="{{verifiedProductImage.path}}" mode="aspectFit"/><text>{{verifiedProductImage.sourceNote}}</text><text class="muted">原图片 SHA256 已校验一致；准确引用见来源审阅</text></view>
    <view wx:for="{{supplierMonitors}}" wx:key="id" class="card"><text class="card-title">七天原商品结果</text><text>{{item.sampleHeadline}}</text><text selectable class="card-detail">{{item.detail}}</text><text wx:if="{{item.summaryText}}" selectable class="card-detail">{{item.summaryText}}</text><text class="card-title">{{item.notificationTitle}}</text><text class="muted">只覆盖七天总结；首采样通知未实现。提供方接受、已读和业务验收分别核对。</text><view class="supplier-actions"><button class="secondary" data-id="{{item.id}}" data-kind="details" bindtap="notificationCard">查看完整来源与回执</button><button class="secondary" data-id="{{item.id}}" data-kind="status" bindtap="notificationCard" disabled="{{loading || uncertain}}">读取原通知状态</button><button wx:if="{{item.canSubscribe}}" class="secondary" data-id="{{item.id}}" data-kind="subscribe" bindtap="notificationCard" disabled="{{loading || uncertain}}">准备原生一次性订阅</button><button wx:if="{{item.canNotifyReview}}" class="secondary" data-id="{{item.id}}" data-kind="review" bindtap="notificationCard" disabled="{{loading || uncertain}}">审阅七天总结通知</button><button wx:if="{{item.canNotifyDecide}}" class="primary" data-id="{{item.id}}" data-kind="decision" bindtap="notificationCard" disabled="{{loading || uncertain}}">决定原通知审批</button><button wx:if="{{item.canNotifyExecute}}" class="primary" data-id="{{item.id}}" data-kind="execute" bindtap="notificationCard" disabled="{{loading || uncertain}}">独立执行原通知</button><button wx:if="{{item.canNotifyCancel}}" class="quiet" data-id="{{item.id}}" data-kind="cancel" bindtap="notificationCard" disabled="{{loading || uncertain}}">取消原通知</button><button wx:if="{{item.canNotifyRevoke}}" class="quiet" data-id="{{item.id}}" data-kind="revoke" bindtap="notificationCard" disabled="{{loading || uncertain}}">撤销原订阅</button><button class="secondary" data-id="{{item.id}}" data-kind="check" bindtap="monitorAction" disabled="{{loading || uncertain || item.stoppedAt}}">审阅并读取一次</button><button class="quiet" data-id="{{item.id}}" data-kind="stop" bindtap="monitorAction" disabled="{{loading || uncertain || item.stoppedAt}}">停止原监测</button></view></view>
    <view wx:for="{{publicationCards}}" wx:key="id" class="card"><text class="card-title">{{item.title}}</text><text selectable class="card-detail">{{item.detail}}</text><text class="muted">{{item.mediaNote}}</text><text wx:if="{{item.timeNote}}" class="muted">{{item.timeNote}}</text><view class="supplier-actions"><button wx:if="{{item.decide}}" class="primary" data-id="{{item.id}}" data-kind="decision" bindtap="publicationCard" disabled="{{loading || uncertain}}">审阅并决定写入</button><button wx:if="{{item.execute}}" class="primary" data-id="{{item.id}}" data-kind="execute" bindtap="publicationCard" disabled="{{loading || uncertain}}">独立执行已批准操作</button><button wx:if="{{item.repair}}" class="secondary" data-id="{{item.id}}" data-kind="repair" bindtap="publicationCard" disabled="{{loading || uncertain}}">审阅原草稿缺失步骤修复</button><button wx:if="{{item.reconcile}}" class="secondary" data-id="{{item.id}}" data-kind="reconcile" bindtap="publicationCard" disabled="{{loading || uncertain}}">只读核对原回执</button></view></view>
  </scroll-view>
  <view wx:if="{{readError}}" class="notice" role="alert"><text>{{readError}}</text><button class="secondary" bindtap="open" disabled="{{loading}}">重新读取云端</button></view>
  <view wx:if="{{error}}" class="notice" role="alert">{{error}}</view>
  <text wx:if="{{publicationError}}" class="notice" role="alert">{{publicationError}}</text>
  <text wx:if="{{supplierReadError || supplierNotice}}" class="notice" role="status">{{supplierReadError || supplierNotice}}</text>
  <view wx:if="{{runtimeNotice &amp;&amp; !supplierMode}}" class="muted runtime-notice">{{runtimeNotice}}</view>
  <button wx:if="{{!authenticated}}" class="primary login" bindtap="login" loading="{{loading}}" disabled="{{loading}}">登录企业空间</button>
  <view class="composer" wx:else>
    <view class="attachments" wx:for="{{files}}" wx:key="id"><text>{{item.filename}} · 原文件已保存</text><button class="secondary" data-id="{{item.id}}" bindtap="removeFile" disabled="{{loading || uncertain}}">移除</button></view>
    <text wx:if="{{files.length}}" class="muted attachment-note">{{supplierMode ? '本次商品只提交文字；图片单独保存准确来源，PDF仅存档，不解析。' : '文本文件随发送交给当前模型；图片/PDF仅存档，请附文字说明。'}}</text><view wx:if="{{replyInquiryId}}" class="notice"><text>正在回复原采购需求 · {{replyInquiryId}}</text><button class="quiet" bindtap="exitProcurementReply" disabled="{{loading || uncertain}}">返回目标</button></view><view wx:if="{{supplierMode &amp;&amp; !replyInquiryId}}" class="supplier-banner"><text>{{supplierCommand === 'shopify-publish' ? '输入真实渠道 Publication gid；发布须独立审批和执行' : supplierCommand === 'monitors' ? '七天配置：提供原商品 gid 和 UTC 开始时间，确认后仍未启用' : supplierCommand === 'shopify-observation' ? '只核对既有 Shopify 商品，不创建或发布' : '供应商商品事实 · Pi 云端保存，预览/外发各自确认'}}</text><button class="quiet" bindtap="startNewSupplier" disabled="{{loading || uncertain}}">新商品</button><button class="quiet" bindtap="exitSupplier" disabled="{{loading || uncertain}}">返回目标</button></view><textarea value="{{draft}}" bindinput="draft" auto-height maxlength="10000" placeholder="{{replyInquiryId ? '给原采购方的明确回复…' : supplierMode ? composerHint : goalMode ? composerHint : '描述目标或需要补充的信息…'}}" disabled="{{loading || uncertain || (goalBlocked &amp;&amp; !replyInquiryId &amp;&amp; !supplierMode)}}"/>
    <view class="composer-actions"><button class="secondary" bindtap="chooseImage" disabled="{{busy || loading || uncertain || replyInquiryId}}">图片</button><button class="secondary" bindtap="chooseFile" disabled="{{busy || loading || uncertain || replyInquiryId}}">文件</button><button class="secondary" bindtap="openReferences" disabled="{{loading}}">引用资料</button><button class="primary" bindtap="send" disabled="{{loading || uncertain || (!replyInquiryId &amp;&amp; (busy || (goalBlocked &amp;&amp; !supplierMode))) || !draft}}" loading="{{loading}}">{{replyInquiryId ? '审阅回复' : supplierCommand ? '审阅范围' : '发送'}}</button></view>
    <view wx:if="{{uncertain}}" class="notice"><text>{{pendingLabel}}结果尚未确认，已保留原请求。</text><button class="secondary" bindtap="reviewPending">查看原请求</button><button class="secondary" bindtap="retry" disabled="{{loading}}">{{pendingLabel === '原外部执行' ? '只读核对原操作' : '核对原请求结果'}}</button><button wx:if="{{publicationNotAdmitted}}" class="secondary" bindtap="reviewUnadmittedPublication" disabled="{{loading}}">审阅重提同一未接收请求</button></view>
    <view class="session-line"><text class="muted">{{readAt ? '云端状态 · ' + readAt : '正在读取云端'}}</text><button wx:if="{{supplierAvailable}}" class="quiet" bindtap="beginSupplier" disabled="{{loading || uncertain}}">商品服务</button><button class="quiet" bindtap="openProcurement" disabled="{{loading}}">采购需求</button><button class="quiet" bindtap="logout" disabled="{{loading}}">退出登录</button></view>
  </view>
  <view wx:if="{{reviewCard}}" class="sheet-backdrop"><view class="sheet"><view class="sheet-heading"><text>{{reviewCard.title}}</text><button class="secondary" bindtap="closeReview" disabled="{{loading}}">返回</button></view><scroll-view scroll-y class="review-content"><text selectable class="review-detail">{{reviewCard.detail}}</text><text wx:if="{{reviewCard.runId}}" class="muted">原运行 {{reviewCard.runId}}</text><text class="muted review-note">{{reviewCard.operation === 'approve' ? '本次只保存范围决定。批准后仍需明确执行；业务目标和关联资料均不代替审批。' : reviewCard.operation === 'cancel' ? '请求停止后，以云端或原执行端的状态为准。' : reviewCard.operation === 'accept' ? '确认当前回执与文件；外部结论仍需独立核验。' : '确认后提交上面的具体操作。'}}</text></scroll-view><view class="review-actions"><button wx:if="{{reviewCard.operation === 'approve'}}" class="secondary" data-decision="deny" bindtap="confirmCard" disabled="{{loading || uncertain}}">拒绝此项</button><button class="primary" data-decision="confirm" bindtap="confirmCard" disabled="{{loading || uncertain}}">{{reviewLabel}}</button></view></view></view>
  <view wx:if="{{preview}}" class="sheet-backdrop"><view class="sheet"><view class="sheet-heading"><text>{{preview.title}}</text><button class="secondary" bindtap="closePreview">返回</button></view><text wx:if="{{preview.verified}}" class="muted">原下载文件 SHA256 已核对一致</text><scroll-view scroll-y class="review-content"><text selectable class="review-detail">{{preview.content}}</text></scroll-view></view></view>
  <view wx:if="{{referencesOpen}}" class="sheet-backdrop"><view class="sheet"><view class="sheet-heading"><text>会话资料</text><button class="secondary" bindtap="closeReferences">返回会话</button></view><scroll-view scroll-y class="sheet-content"><view class="company"><text>{{company.displayName || company.legalName || '企业资料尚未导入'}}</text><text class="muted">{{company.description}}</text></view><text class="muted">按需引用原修订。企业私有资料关联不代表允许导出到模型或连接器。</text><button wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" data-kind="product" bindtap="reference" class="reference" disabled="{{busy || loading || uncertain}}"><text>{{item.name}}</text><text class="muted">产品修订 {{item.revision}} · 点击切换引用</text></button><button wx:for="{{documents}}" wx:key="id" data-id="{{item.id}}" data-kind="document" bindtap="reference" class="reference" disabled="{{busy || loading || uncertain}}"><text>{{item.title}}</text><text class="muted">资料 v{{item.currentVersion}} · 点击切换引用</text></button><text wx:if="{{!products.length &amp;&amp; !documents.length}}" class="muted">可先通过已有资料库导入资料，再回来引用。</text><text class="muted" wx:if="{{resourceCards.length}}">会话原文件 · 校验后打开</text><button wx:for="{{resourceCards}}" wx:key="id" class="reference" data-id="{{item.id}}" bindtap="card" disabled="{{loading || uncertain}}">{{item.title}}</button><text class="muted">已引用 {{references.products.length}} 个产品、{{references.documents.length}} 份资料</text></scroll-view></view></view>
  <view wx:if="{{procurementOpen}}" class="sheet-backdrop"><view class="sheet"><view class="sheet-heading"><text>采购需求</text><button class="secondary" bindtap="closeProcurement">返回会话</button></view><scroll-view scroll-y class="review-content"><text class="muted">只读取采购方已确认的原共享；关联和回复不启动 Muse，也不附私有资料。</text><text wx:if="{{procurementError}}" class="notice">{{procurementError}}</text><view wx:for="{{procurementInbox}}" wx:key="id" class="card"><text class="card-title">{{item.quantity}} 件 · {{item.destination}}</text><text>{{item.notes}}</text><text class="muted">原 SKU {{item.share.snapshot.productRef.skuCode}} · 已共享给 {{item.share.snapshot.recipient.displayName}}</text><button class="secondary card-action" data-id="{{item.id}}" bindtap="bindProcurement" disabled="{{loading || uncertain}}">关联到本会话</button></view><view wx:for="{{procurementAssociated}}" wx:key="id" class="card"><text class="card-title">本会话需求 · {{item.quantity}} 件 · {{item.destination}}</text><text>{{item.notes}}</text><text class="muted">原 SKU {{item.share.snapshot.productRef.skuCode}} · 修订 {{item.revision}}</text><view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="procurement-reply"><text selectable>{{reply.content}}</text><text class="muted">{{reply.createdAt}} · 已提交原回复，非采购订单或付款证明</text></view><button class="secondary card-action" data-id="{{item.id}}" bindtap="beginProcurementReply" disabled="{{loading || uncertain}}">回复原采购方</button></view><text wx:if="{{!procurementInbox.length &amp;&amp; !procurementAssociated.length &amp;&amp; !procurementError}}" class="muted">当前没有可关联或回复的原共享采购需求。</text></scroll-view></view></view>
  <view wx:if="{{procurementReview}}" class="sheet-backdrop"><view class="sheet"><view class="sheet-heading"><text>{{procurementReview.kind === 'bind' ? '确认关联原需求' : '审阅原采购回复'}}</text><button class="secondary" bindtap="closeProcurementReview" disabled="{{loading}}">返回</button></view><scroll-view scroll-y class="review-content"><text selectable class="review-detail">{{procurementReview.detail}}</text><text wx:if="{{procurementReview.kind === 'reply'}}" selectable class="review-detail procurement-reply">本次只提交以下文字：
{{procurementReview.content}}</text><text class="muted review-note">{{procurementReview.kind === 'bind' ? '确认关联到当前主会话，仅保存引用，不转发给 Muse 或模型。' : '确认仅向此原需求的采购方提交以上回复，不附企业/产品/文件资料，不构成采购订单、付款或额外执行授权。'}}</text><text wx:if="{{error}}" class="notice">{{error}}</text></scroll-view><view class="review-actions"><button class="primary" bindtap="confirmProcurement" disabled="{{loading || uncertain}}">{{procurementReview.kind === 'bind' ? '确认关联本会话' : '确认提交原回复'}}</button></view></view></view>
  <view wx:if="{{supplierResourcesOpen}}" class="sheet-backdrop"><view class="sheet"><view class="sheet-heading"><text>原商品资源与结果</text><button class="secondary" bindtap="closeSupplierResources">返回会话</button></view><scroll-view scroll-y class="review-content"><view wx:for="{{supplierServices}}" wx:key="id"><view wx:if="{{item.id === selectedSupplierId}}"><text>{{item.profile.name}}</text><text class="muted">内部事实修订 {{item.revision}} · {{item.externalStatus}}</text><button class="reference" data-id="{{item.id}}" data-kind="details" bindtap="supplierAction">查看内部资料和必要缺项</button><button class="reference" data-id="{{item.id}}" data-kind="images" bindtap="supplierAction" disabled="{{loading || uncertain || item.phase === 'pending'}}">审阅并保存选中图片来源</button><view wx:for="{{item.profile.images}}" wx:for-item="source" wx:for-index="imageIndex"><text class="muted">{{source.sourceNote}}</text><button wx:if="{{source.kind === 'artifact'}}" class="reference" data-id="{{item.id}}" data-index="{{imageIndex}}" bindtap="supplierImage" disabled="{{loading}}">核对 SHA 并查看原图片</button><text wx:else class="muted">公开 URL 可用性尚未核验：{{source.url}}</text></view><button class="reference" data-id="{{item.id}}" data-kind="save-product" bindtap="supplierAction" disabled="{{loading || uncertain || item.phase === 'pending'}}">审阅并存入原产品库</button><button class="reference" data-id="{{item.id}}" data-kind="shopify-observation" bindtap="supplierAction" disabled="{{loading || uncertain}}">核对已有 Shopify 商品</button><button class="reference" data-id="{{item.id}}" bindtap="beginDraftWrite" disabled="{{loading || uncertain || !item.preview || publicationError}}">审阅草稿创建与已选图片上传</button><button class="reference" data-id="{{item.id}}" bindtap="beginChannelPublish" disabled="{{loading || uncertain || !item.preview || publicationError}}">单独准备精确渠道发布</button><text class="muted">{{publicationState.configured ? publicationState.writesEnabled ? '主机写入已配置，仍需原 Connector 与每项审批' : '当前主机未启用写入，不创建或发布' : 'Shopify 尚未配置，不生成真实草稿或发布回执'}}。批准后还需独立执行；未知结果只读核对。</text><button class="reference" data-id="{{item.id}}" data-kind="monitors" bindtap="supplierAction" disabled="{{loading || uncertain}}">审阅七天原商品配置</button><text class="muted">配置后仍需原 Schedule 审批；原会话总结不代表外部通知。</text><view class="supplier-actions"><button class="quiet" data-id="{{item.id}}" data-kind="cancel" bindtap="supplierAction" disabled="{{loading || uncertain || item.phase === 'cancelled' || item.phase === 'rejected'}}">停止商品整理</button><button class="quiet" data-id="{{item.id}}" data-kind="reject" bindtap="supplierAction" disabled="{{loading || uncertain || item.phase === 'cancelled' || item.phase === 'rejected'}}">拒绝商品整理</button></view></view></view></scroll-view></view></view>
  <view wx:if="{{supplierReview}}" class="sheet-backdrop"><view class="sheet"><view class="sheet-heading"><text>确认本次原服务范围</text><button class="secondary" bindtap="closeSupplierReview" disabled="{{loading}}">返回</button></view><scroll-view scroll-y class="review-content"><text selectable class="review-detail">{{supplierReview.detail}}</text><text wx:if="{{error}}" class="notice">{{error}}</text></scroll-view><view class="review-actions"><button class="primary" bindtap="confirmSupplierReview" disabled="{{loading || uncertain}}">确认本次具体操作</button></view></view></view>
  <supplier-public-review scope="{{supplierScope}}" busy="{{loading}}" uncertain="{{uncertain}}" server-error="{{error}}" bind:preview="confirmSupplierPreview" bind:close="closeSupplierScope"/>
  <view wx:if="{{notificationNotAdmitted}}" class="notice"><text>原通知执行未接收，批准尚未使用；不会自动重发。</text><button class="secondary" bindtap="reviewUnadmittedNotification" disabled="{{loading}}">明确确认同一原通知请求</button></view><shopify-operation-review review="{{shopifyReview}}" busy="{{loading}}" uncertain="{{uncertain &amp;&amp; shopifyReview.stage !== 'retry'}}" server-error="{{error}}" bind:confirm="confirmShopifyReview" bind:deny="denyShopifyReview" bind:close="closeShopifyReview"/>
  <muse-draft-review draft="{{selectedDraft}}" busy="{{loading}}" uncertain="{{uncertain}}" server-error="{{error}}" bind:prepare="prepareDraft" bind:edit="editDraft" bind:reject="rejectDraft" bind:close="closeDraft"/>
</view>
