.conversation{min-height:100vh;box-sizing:border-box;padding:20rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column}.companion{display:flex;align-items:center;flex-direction:column;padding:12rpx 0 24rpx}.spirit{width:160rpx;height:160rpx}.transcript{flex:1;max-height:60vh}.welcome{padding:32rpx 10rpx;line-height:1.8;color:#777b71}.message{padding:22rpx 26rpx;margin:16rpx 0;border-radius:26rpx;line-height:1.7;white-space:pre-wrap}.message.user{background:#e7ebe2;margin-left:56rpx}.message.assistant{background:#fff;margin-right:24rpx}.message.system{font-size:24rpx;color:#767c73}.card{display:flex;flex-direction:column;align-items:flex-start;background:#fff;border:1rpx solid #e4e5dc;text-align:left;padding:24rpx;margin:18rpx 0;line-height:1.6}.card-title{font-weight:600}.card-detail{font-size:24rpx;color:#747c70;white-space:pre-wrap;word-break:break-all}.card-action{color:#3c5345;font-size:24rpx;margin-top:12rpx}.notice{display:block;background:#eee9db;padding:18rpx 20rpx;font-size:24rpx;border-radius:20rpx;margin:12rpx 0;line-height:1.6}.composer{padding-top:20rpx}.composer textarea{background:#fff;border-radius:24rpx;padding:24rpx;box-sizing:border-box;width:100%;min-height:110rpx;max-height:260rpx}.composer-actions{display:flex;gap:12rpx;margin-top:16rpx}.composer-actions button{padding:0 20rpx;line-height:66rpx}.composer-actions .primary{margin-left:auto}.attachments text{display:block;font-size:22rpx;color:#61715a;padding:8rpx 0}.sheet-backdrop{position:fixed;inset:0;background:rgba(35,40,32,.3);display:flex;align-items:flex-end;z-index:10}.sheet{width:100%;background:#f7f5ef;border-radius:34rpx 34rpx 0 0;padding:28rpx;box-sizing:border-box}.sheet-heading{display:flex;justify-content:space-between;align-items:center;font-weight:600}.sheet-content{height:65vh;padding-top:24rpx}.company{background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:20rpx}.company text{display:block;line-height:1.7}.reference{display:flex;flex-direction:column;align-items:flex-start;text-align:left;background:#fff;padding:24rpx;margin:16rpx 0;line-height:1.7}.sheet-content>.muted{font-size:24rpx;line-height:1.7}
