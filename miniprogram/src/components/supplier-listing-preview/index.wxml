<view wx:if="{{view}}" class="card supplier-preview"><text class="card-title">{{view.title}}</text><text class="supplier-price">{{view.price}}</text><text class="card-detail">{{view.pack}} · 销售国家 {{view.market}}</text><text wx:for="{{view.paragraphs}}" wx:key="*this" selectable class="card-detail">{{item}}</text><text class="muted">SKU {{view.sku}}</text><text class="muted">{{view.fulfillment}}</text><view wx:for="{{view.images}}" wx:key="key" class="supplier-source"><text selectable>{{item.label}}</text><text>{{item.sourceNote}}</text><text class="muted">{{item.status}}</text></view><text wx:for="{{view.missing}}" wx:key="*this" class="notice">仍需补充：{{item}}</text><text class="muted supplier-status">{{view.status}}</text></view><text wx:if="{{error}}" class="notice" role="alert">{{error}}</text>
