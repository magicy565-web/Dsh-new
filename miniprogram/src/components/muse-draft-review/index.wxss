.draft-term{display:block;font-size:26rpx;line-height:1.8;margin-top:18rpx}.draft-suggestions text{display:block;font-size:24rpx;line-height:1.7}.draft-consents label{display:block;font-size:25rpx;line-height:1.8;margin:20rpx 0}.draft-consents checkbox{transform:scale(.85);vertical-align:middle}.draft-review-actions{display:flex;flex-wrap:wrap;gap:14rpx;padding:20rpx 0 calc(16rpx + env(safe-area-inset-bottom))}.draft-review-actions button{flex:1;min-width:180rpx;font-size:24rpx;line-height:70rpx}.draft-review-actions .primary{flex-basis:100%}
